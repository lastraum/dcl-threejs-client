# Copy to .env for local overrides (never commit .env).

# Client — leave false locally; set true when building for prod with analytics
VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_URL=   # optional absolute ingest; default same-origin /api/analytics/events

# Analytics Node service (PM2 / production)
ANALYTICS_PORT=8787
# ANALYTICS_EVENTS_PATH=./data/place-events.jsonl

# Optional Supabase mirror (service_role only — never in browser)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
