# Copy to .env for local overrides (never commit .env).

# Loot Bag — always same-origin proxies (no browser CORS to external hosts)
# VITE_META_TX_URL=/api/meta-tx/v1/transactions
# VITE_MARKETPLACE_API=/api/marketplace/v1
# VITE_POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# VITE_LOOTBAG_FAKE_CLAIM=true   # optional: mock claim UI only (default is real pull/settle)

# Client analytics (also forced by npm scripts — see package.json)
#   npm run build       → analytics OFF  (local + staging / dev.decentraland.social)
#   npm run build:prod  → analytics ON   (decentraland.social only)
VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_URL=   # optional absolute ingest; default same-origin /api/analytics/events

# Analytics Node service (PM2 / production)
ANALYTICS_PORT=8787
# ANALYTICS_EVENTS_PATH=./data/place-events.jsonl

# Optional Supabase mirror (service_role only — never in browser)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
