# Copy to .env for local overrides (never commit .env).

# Grab bag meta-tx (Polygon)
# Dev: defaults to /v1/transactions (Vite → https://transactions.lastslice.co)
# Prod build: defaults to https://transactions.lastslice.co/v1/transactions
# Local self-relayer: point Vite /v1 at localhost:5356, keep relative URL
# VITE_META_TX_URL=/v1/transactions
# VITE_META_TX_URL=https://transactions.lastslice.co/v1/transactions
# VITE_GACHA_FAKE_CLAIM=false

# Client analytics (also forced by npm scripts — see package.json)
#   npm run build       → analytics OFF  (local + staging / dev.decentraland.social)
#   npm run build:prod  → analytics ON   (decentraland.social only)
VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_URL=   # optional absolute ingest; default same-origin /api/analytics/events

# Analytics Node service (PM2 / production)
ANALYTICS_PORT=8787
# ANALYTICS_EVENTS_PATH=./data/place-events.jsonl

# Optional Supabase mirror (service_role only — never in browser)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
