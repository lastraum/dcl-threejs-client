[Unit]
Description=DCL Three.js Client suggestion API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dcl-threejs-client
EnvironmentFile=-/etc/dcl-threejs/suggestion-api.env
ExecStart=/usr/bin/node server/suggestion-api.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target