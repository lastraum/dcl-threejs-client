{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react",
    "jsxFactory": "ReactEcs.createElement",
    "jsxFragmentFactory": "ReactEcs.Fragment",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "bin",
    "lib": ["ES2020"]
  },
  "include": ["src/**/*"],
  "extends": "./node_modules/@dcl/sdk/types/tsconfig.ecs7.json"
}
